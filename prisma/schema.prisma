datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String             @id @default(cuid())
  name            String?
  email           String?            @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  playlists       Playlist[]
  likedTracks     UserLikedTrack[]
  followedArtists UserFollowedArtist[]
  savedAlbums     UserSavedAlbum[]
  listeningHistory ListeningHistory[]
}

model Artist {
  id               String               @id @default(cuid())
  name             String
  image            String
  bannerUrl        String?
  bio              String?
  monthlyListeners Int                  @default(0)
  verified         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tracks           Track[]
  albums           Album[]
  followers        UserFollowedArtist[]
}

model Album {
  id          String           @id @default(cuid())
  title       String
  artistId    String
  coverUrl    String
  releaseYear Int
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  artist      Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      Track[]
  savedBy     UserSavedAlbum[]

  @@index([artistId])
}

model Track {
  id           String             @id @default(cuid())
  title        String
  artistId     String
  albumId      String?
  duration     Int                // in seconds
  audioUrl     String
  coverUrl     String
  trackNumber  Int?
  releaseDate  String?
  explicit     Boolean            @default(false)
  lyrics       String?
  lyricsSynced String?            // JSON string with array of { time: number, text: string }
  playCount    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  artist       Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album        Album?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlists    PlaylistTrack[]
  likes        UserLikedTrack[]
  genres       TrackGenre[]
  history      ListeningHistory[]

  @@index([artistId])
  @@index([albumId])
}

model Playlist {
  id          String          @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  userId      String
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
}

model UserLikedTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  likedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model UserFollowedArtist {
  id         String   @id @default(cuid())
  userId     String
  artistId   String
  followedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model UserSavedAlbum {
  id        String   @id @default(cuid())
  userId    String
  albumId   String
  savedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId])
  @@index([albumId])
}

model ListeningHistory {
  id       String   @id @default(cuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([playedAt])
}

model Genre {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String?
  imageUrl  String?
  createdAt DateTime     @default(now())

  tracks    TrackGenre[]
}

model TrackGenre {
  id       String @id @default(cuid())
  trackId  String
  genreId  String

  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([trackId, genreId])
  @@index([trackId])
  @@index([genreId])
}
